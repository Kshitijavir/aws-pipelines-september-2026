{
  "name": "notebook-dependency-job",
  "tasks": [
    {
      "task_key": "notebook_1",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/notebook_1"
      }
    },
    {
      "task_key": "notebook_2",
      "depends_on": [
        {
          "task_key": "notebook_1"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/notebook_2"
      },
      "run_if": "ALL_SUCCESS"
    }
  ]
}
