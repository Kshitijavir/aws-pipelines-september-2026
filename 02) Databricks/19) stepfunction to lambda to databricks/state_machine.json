{
  "Comment": "AWS Step Functions - Databricks Job Monitoring",
  "StartAt": "Invoke Databricks Lambda",
  "States": {
    "Invoke Databricks Lambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "YOUR LAMBDA ARN",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "Check Job Status"
    },
    "Check Job Status": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "SUCCESS",
          "Next": "Job Completed Successfully"
        },
        {
          "Variable": "$.status",
          "StringEquals": "FAILED",
          "Next": "Job Failed"
        },
        {
          "Variable": "$.status",
          "StringEquals": "STARTED",
          "Next": "Wait 1 Minute"
        },
        {
          "Variable": "$.status",
          "StringEquals": "RUNNING",
          "Next": "Wait 1 Minute"
        }
      ],
      "Default": "Job Failed"
    },
    "Wait 1 Minute": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "Invoke Databricks Lambda"
    },
    "Job Completed Successfully": {
      "Type": "Succeed"
    },
    "Job Failed": {
      "Type": "Fail",
      "Error": "DatabricksJobFailed",
      "Cause": "Databricks job did not complete successfully."
    }
  }
}
